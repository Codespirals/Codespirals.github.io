@page "/solutions"
@using Codespirals.HomePage.Models.GitHub
@inject IGitHubService GitHubService

<div class="content">
    <h2>Solutions</h2>
    <p>
        A collection of purpose built software that solve a specific problem, which modularly integrate into other projects.
    </p>
    <p>
        This Website itself is based on the <a href="https://github.com/Codespirals/Codespirals.Blazor.WebsiteTemplate">Codespirals.Blazor.WebsiteTemplate</a> and uses the ApiCaller solution to get the information about the repositories from GitHub!
    </p>
</div>

@foreach (var repo in _repos)
{
    <Repository Repo="repo"></Repository>
}

@code {
    private IEnumerable<Repo> _repos = [];

    protected override async Task OnInitializedAsync()
    {
        _repos = await GitHubService.GetSolutions();
    }
}
