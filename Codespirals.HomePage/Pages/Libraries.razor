@page "/libraries"
@using Codespirals.HomePage.Models.GitHub
@inject IGitHubService GitHubService


<div class="content">
    <h2>Libraries</h2>
    <p>
        A collection of reusable libraries that present a solid foundation for other projects to build on.
    </p>
</div>
@foreach (var repo in _repos)
{
    <Repository Repo="repo"></Repository>
}

@code {
    private IEnumerable<Repo> _repos = [];

    protected override async Task OnInitializedAsync()
    {
        _repos = await GitHubService.GetLibraries();
    }
}
 